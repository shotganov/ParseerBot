[Unit]
Description=ParserBot Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/cloud/ParseerBot
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/cloud/ParseerBot/env/bin/python3 bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
